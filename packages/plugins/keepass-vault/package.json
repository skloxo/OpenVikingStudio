{
  "name": "dsh-plugin-keepass-vault",
  "version": "1.2.5",
  "type": "module",
  "main": "index.js",
  "description": "KeePass Vault 本地私有化凭据插件 (客户端本地挂载 KDBX + 查库第一公理 + 零云端依赖)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "keepass",
    "vault",
    "credentials",
    "mcp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
