{
  "name": "dsh-plugin-tududi",
  "version": "1.1.9",
  "type": "module",
  "main": "index.js",
  "description": "Tududi 全域任务管理与 OKR+GTD 生产力中枢官方标准插件 (双网自愈网关 + 五重参数守卫 + 65 项 MCP 算子)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "antigravity",
    "tududi",
    "todo",
    "tasks",
    "habits",
    "projects",
    "okr",
    "gtd",
    "mcp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "tools.json",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "author": "OpenViking Team",
  "license": "AGPL-3.0"
}