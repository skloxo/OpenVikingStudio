{
  "name": "dsh-plugin-cpa",
  "version": "1.0.1",
  "type": "module",
  "main": "index.js",
  "description": "CPA 跨模型算力协同中枢 DSH 独立桥接器 (支持多模型聚合分摊与 2080Ti 算力集群调度)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "cpa",
    "compute"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
