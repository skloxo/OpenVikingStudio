{
  "name": "dsh-plugin-openviking",
  "version": "2.0.41",
  "type": "module",
  "main": "index.js",
  "description": "OpenViking 体外大脑客户端通用 RPC 通信桥梁与先验 Hook 套件 (支持核心记忆、联网搜索与凭据中枢全量动态能力投影)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "openviking",
    "mcp",
    "memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "config.mjs",
    "mcp.mjs",
    "cordis.patch.yml",
    "README.md",
    "servers/",
    "shared/",
    "SKILL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
