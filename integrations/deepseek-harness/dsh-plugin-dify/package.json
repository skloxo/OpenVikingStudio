{
  "name": "dsh-plugin-dify",
  "version": "1.0.1",
  "type": "module",
  "main": "index.js",
  "description": "Dify 智能体与工作流中枢 DSH 独立桥接器 (支持工作流唤起、Agent 协同与知识库检索)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "dify",
    "workflow"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
