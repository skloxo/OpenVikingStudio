{
  "name": "dsh-plugin-search-gateway",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "description": "Search Gateway 独立多引擎联网搜索与采集聚合插件 (26-Key 轮询矩阵 + 12大原子工具)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "search-gateway",
    "mcp",
    "search"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "schema.js",
    "README.md",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
