{
  "name": "dsh-plugin-openviking-memory",
  "version": "2.0.22",
  "type": "module",
  "main": "index.js",
  "description": "体外大脑长程记忆语义检索、代码感知、上下文路由与经验沉淀完全体 (34 项战地工具 + 3 项 Hook 物理守卫)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "openviking",
    "openviking-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "config.mjs",
    "mcp.mjs",
    "cordis.patch.yml",
    "README.md",
    "servers/",
    "shared/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
